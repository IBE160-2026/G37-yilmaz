2,192.6,693.24],"width":340.6559999999998,"hasEOL":true},{"str":"de fleste emnene er intensive og prosjektorienterte. I forelesninger","transform":[12,0,0,12,192.6,679.44],"width":318.1547999999997,"hasEOL":true},{"str":"gjennomgås teori og faglige tema. I gruppearbeidet forventes studentene","transform":[12,0,0,12,192.6,665.6400000000001],"width":347.56799999999976,"hasEOL":true},{"str":"å være aktive i diskusjoner av problemstillinger i fagstoffet. Studentene","transform":[12,0,0,12,192.6,651.8400000000001],"width":343.1279999999996,"hasEOL":true},{"str":"arbeider på laboratorier der obligatoriske prosjektoppgaver løses for å","transform":[12,0,0,12,192.6,638.0400000000002],"width":335.08799999999985,"hasEOL":true},{"str":"tilegne praktiske ferdigheter ved å designe, bygge og vedlikeholde","transform":[12,0,0,12,192.6,624.2400000000002],"width":318.8879999999999,"hasEOL":true},{"str":"datasystemer, enten individuelt eller i team med andre studenter.","transform":[12,0,0,12,192.6,610.4400000000003],"width":309.7187999999999,"hasEOL":false},{"str":"Studentene vil i tillegg til å samarbeide med andre informatikkstudenter,","transform":[12,0,0,12,192.6,582.84],"width":347.8787999999997,"hasEOL":true},{"str":"også arbeide med mennesker som har kunnskap på helt andre områder.","transform":[12,0,0,12,192.6,569.0400000000001],"width":340.0799999999998,"hasEOL":true},{"str":"For å trene på dette er det viktig at studenten tar en aktiv rolle, er til stede","transform":[12,0,0,12,192.6,555.24],"width":352.2491999999994,"hasEOL":true},{"str":"og bidrar i læringsmiljøet, både i den organiserte undervisningen og","transform":[12,0,0,12,192.6,541.4399],"width":325.7999999999997,"hasEOL":true},{"str":"ellers i arbeidsuka der studentene samarbeider og i stor grad lærer av","transform":[12,0,0,12,192.59999999999997,527.6399],"width":330.1199999999998,"hasEOL":true},{"str":"hverandre.","transform":[12,0,0,12,192.59999999999997,513.8399000000001],"width":50.88,"hasEOL":false},{"str":