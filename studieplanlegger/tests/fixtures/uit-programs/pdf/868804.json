00000000000003,"hasEOL":false},{"str":"Internasjonalisering","transform":[11.04,0,0,11.04,75.12,587.04],"width":87.47985599999996,"hasEOL":false},{"str":"Det vil hvert semester være internasjonale studenter på de","transform":[12,0,0,12,192.6,586.2],"width":277.8467999999999,"hasEOL":true},{"str":"engelskspråklige emnene, som enten er på utveksling eller er","transform":[12,0,0,12,192.6,572.4],"width":292.11599999999976,"hasEOL":true},{"str":"programstudenter på mastergradsnivå.","transform":[12,0,0,12,192.6,558.6],"width":183.4800000000001,"hasEOL":false},{"str":"Hvert semester vil studentene inviteres til forelesninger eller seminarer","transform":[12,0,0,12,192.6,532.8],"width":340.4771999999996,"hasEOL":true},{"str":"med faglig relevant tema, som holdes av gjester fra andre læresteder.","transform":[12,0,0,12,192.6,519],"width":330.35879999999975,"hasEOL":false},{"str":"Studentutveksling","transform":[11.04,0,0,11.04,75.12,491.16],"width":79.55976000000001,"hasEOL":false},{"str":"Studenter som ønsker det, kan gjennomføre et utenlandsopphold i","transform":[12,0,0,12,192.6,490.32],"width":315.696,"hasEOL":true},{"str":"studiets 5. og / eller 6. semester. Emnene planlagt gjennomført i","transform":[12,0,0,12,192.6,476.52],"width":306.81599999999975,"hasEOL":true},{"str":"utvekslingsperioden må søkes forhåndsgodkjent etter dialog med","transform":[12,0,0,12,192.6,462.72],"width":311.87999999999965,"hasEOL":true},{"str":"instituttet. Instituttet vil i hvert enkelt tilfelle vurdere på hvilken måte og","transform":[12,0,0,12,192.6,448.92],"width":347.88119999999964,"hasEOL":true},{"str":"i hvilket omfang eksterne emner vil kunne erstatte obligatoriske emner i","transform":[12,0,0,12,192.6,435.12],"width":345.8159999999997,"hasEOL":true},{"str":"studentens utdanningsplan ved UiT.","transform":[12,0,0,12,192.6,421.32],"width":172.56000000000003,"hasEOL":true},{"str":"Studenter som ønsker utenlandsopphold som en del av","transform":[12,0,0,12,192.6,393.72],"width":261.59999999999997,"hasEOL":true},{"str":"informatikkstudiet må ta kontakt i god tid før utreise, senest ved","transform":[12,0,0,12,192.6,379.92],"width":307.4399999999998,"hasEOL":true},{"str":"semesterstart i semesteret før utreise. De forhåndsgodkjente emnene","transform":[12,0,0,12,192.6,366.12],"width":327.16679999999985,"hasEOL":true},{"str":"inngår som en del av studiet UiT. Manglende gjennomføring av","transform":[12,0,0,12,192.6,352.32],"width":305.87999999999977,"hasEOL":true},{"str":"forhåndsgodkjent opplegg kan medføre forlenget studietid.","transform":[12,0,0,12,192.6,338.52],"width":282.7199999999998,"hasEOL":true},{"str":"Arbeidsmengden skal være representativ for den tidsperiode studenten er","transform":[12,0,0,12,192.6,310.92],"width":350.5559999999998,"hasEOL":true},{"str":"på utvekslingsopphold.","transform":[12,0,0,12,192.6,297.12],"width":111.36000000000001,"hasEOL":true},{"str":"En oversikt over utvekslingsavtaler finnes på UiT sine nettsider.","transform":[12,0,0,12,192.6,269.52],"width":308.2799999999999,"hasEOL":false},{"str":"Praksis","transform":[11.04,0,0,11.04,75.12,243.6],"width":31.890144,"hasEOL":false},{"str":"-","transform":[11.04,0,0,11.04,192.6,243.6],"width":3.67632,"hasEOL":false},{"str":"Administrativt ansvarlig","transform":[11.04,0,0,11.04,75.12,218.04],"width":107.43244800000005,"hasEOL":true},{"str":"og faglig ansvarlig","transform":[11.04,0,0,11.04,75.12,205.32],"width":82.560432,"hasEOL":false},{"str":"Programstyrefunksjon med det faglige ansvaret for Informatikk –","transform":[12,0,0,12,192.6,217.08],"width":313.56000000000006,"hasEOL":true},{"str":"Bachelor er lagt til et felles programstyre for bachelor, master og","transform":[12,0,0,12,192.6,203.28],"width":311.3987999999998,"hasEOL":true},{"str":"sivilingeniørstudiene i informatikk, campus Tromsø. Institutt for","transform":[12,0,0,12,192.6,189.48],"width":309.87599999999986,"hasEOL":true},{"str":"informatikk ved Fakultet for naturvitenskap og teknologi er","transform"