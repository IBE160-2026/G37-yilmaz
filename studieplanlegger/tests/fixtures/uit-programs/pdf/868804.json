nnskapsproduksjon og annen verdiskapning","transform":[12,0,0,12,192.6,293.88],"width":349.55999999999983,"hasEOL":true},{"str":"i dagens samfunn. Også anvendelse i andre fag brer om seg fordi","transform":[12,0,0,12,192.6,280.08],"width":311.016,"hasEOL":true},{"str":"informatikk er en vesentlig faktor for andre fags videre utvikling.","transform":[12,0,0,12,192.6,266.28],"width":313.3199999999998,"hasEOL":false},{"str":"Studiet kvalifiserer for opptak til 2-årig masterstudium i informatikk","transform":[12,0,0,12,192.6,240.48],"width":328.67999999999967,"hasEOL":true},{"str":"dersom gjennomsnittskarakteren i bachelorstudiet er tilsvarende C eller","transform":[12,0,0,12,192.59999999999994,226.67999999999998],"width":342.1559999999996,"hasEOL":true},{"str":"bedre.","transform":[12,0,0,12,192.59999999999994,212.87999999999997],"width":29.52,"hasEOL":false},{"str":"Arbeidsomfang","transform":[11.04,0,0,11.04,75.12,186.96],"width":68.51644799999995,"hasEOL":false},{"str":"For å fullføre studiet fram til bachelorgrad kreves motivasjon og","transform":[12,0,0,12,192.6,186.12],"width":308.9999999999999,"hasEOL":true},{"str":"målrettet arbeidsinnsats. For å oppnå læringsutbyttet for studiet må","transform":[12,0,0,12,192.6,172.32],"width":321.6491999999997,"hasEOL":true},{"str":"studentene fra studiestart forvente å bruke rundt 40 timer i uka på studiet,","transform":[12,0,0,12,192.6,158.51999999999998],"width":352.19999999999965,"hasEOL":true},{"str":"inkludert forelesninger, gruppetimer, laboratoriearbeid og egendrevet","transform":[12,0,0,12,192.6,144.71999999999997],"width":332.85599999999977,"hasEOL":true},{"str":"selvstudium.","transform":[12,0,0,12,192.6,130.91999999999996],"width":61.08000000000001,"hasEOL":false},{"str":"Studieprogrammets samlede arbeidsomfang er 1500-1800 timer per år","transform":[12,0,0,12,192.6,103.32],"width":336.876,"hasEOL":true},{"str":"for heltidsstudier.","transform":[12,0,0,12,192.59999999999997,89.52],"width":84.6,"hasEOL":false}]},{"