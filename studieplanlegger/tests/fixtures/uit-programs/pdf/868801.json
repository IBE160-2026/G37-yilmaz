08.13599999999974,"hasEOL":true},{"str":"vurderingsform og adgang til eventuelle eksamener i andre semestre","transform":[12,0,0,12,222.72000000000003,95.75999999999998],"width":327.8879999999997,"hasEOL":true},{"str":"framkommer i emnebeskrivelsene.","transform":[12,0,0,12,222.72,81.96],"width":166.20000000000002,"hasEOL":false}]},{"page":6,"items":[{"str":"6","transform":[8.04,0,0,8.04,178.32,33],"width":4.59084,"hasEOL":false},{"str":"Relevans","transform":[12,0,0,12,85.08,779.28],"width":43.908,"hasEOL":false},{"str":"Informatikk er vår tids mest ekspansive, innovative og anvendte fag","transform":[12,0,0,12,222.72,779.28],"width":325.91999999999985,"hasEOL":true},{"str":"og teknologi. Kjennskap til informatikkfaglige metoder og verktøy","transform":[12,0,0,12,222.72,764.28],"width":320.6399999999998,"hasEOL":true},{"str":"inngår i dag i de fleste områder av kunnskapsproduksjon og annen","transform":[12,0,0,12,222.72,749.28],"width":318.48,"hasEOL":true},{"str":"verdiskapning i dagens samfunn. Også anvendelse i andre fag brer","transform":[12,0,0,12,222.72,734.28],"width":318.5159999999999,"hasEOL":true},{"str":"om seg fordi informatikk er en vesentlig faktor for andre fags videre","transform":[12,0,0,12,222.72000000000003,719.28],"width":327.64799999999974,"hasEOL":true},{"str":"utvikling.","transform":[12,0,0,12,222.72000000000003,704.28],"width":46.32000000000001,"hasEOL":false},{"str":"Studiet kvalifiserer for opptak til 2-årig masterstudium i informatikk","transform":[12,0,0,12,222.72,674.28],"width":328.6799999999998,"hasEOL":true},{"str":"dersom gjennomsnittskarakteren i bachelorstudiet er tilsvarende C","transform":[12,0,0,12,222.71999999999994,659.28],"width":317.72399999999976,"hasEOL":true},{"str":"eller bedre.","transform":[12,0,0,12,222.72,644.28],"width":53.879999999999995,"hasEOL":false},{"str":"Arbeidsomfang","transform":[12,0,0,12,85.08,628.32],"width":74.64,"hasEOL":false},{"str":"For å fullføre studiet fram til bachelorgrad kreves motivasjon og","transform":[12,0,0,12,222.72,629.52],"width":308.9999999999999,"hasEOL":true},{"str":"målrettet arbeidsinnsats. For å oppnå læringsutbyttet for studiet må","transform":[12,0,0,12,222.72,615.72],"width":321.64679999999976,"hasEOL":true},{"str":"studentene fra studiestart forvente å bruke inntil 50 timer i uka på","transform":[12,0,0,12,222.72,601.9200000000001],"width":314.20799999999974,"hasEOL":true},{"str":"studiet, inkludert forelesninger, gruppetimer, laboratoriearbeid og","transform":[12,0,0,12,222.72,588.1200000000001],"width":315.2399999999997,"hasEOL":true},{"str":"egendrevet selvstudium.","transform":[12,0,0,12,222.72,574.32],"width":116.64000000000001,"hasEOL":false},{"str":"For masteroppgaver /","transform":[12,0,0,12,85.08,558.24],"width":102.576,"hasEOL":true},{"str":"selvstendig arbeid i","transform":[12,0,0,12,85.08,543.24],"width":93.21599999999998,"hasEOL":true},{"str":"mastergradsprogram","transform":[12,0,0,12,85.08,528.24],"width":98.49600000000001,"hasEOL":false},{"str":"-","transform":[12,0,0,12,222.72,559.44],"width":3.9960000000000004,"hasEOL":false},{"str":"Undervisning og","transform":[12,0,0,12,85.08,512.28],"width":80.28,"hasEOL":true},{"str":"eksamensspråk","transform":[12,0,0,12,85.08,497.28],"width":72.47999999999999,"hasEOL":false},{"str":"Studieprogrammets språk er norsk, og de fleste emner er","transform":[12,0,0,12,222.72,513.48],"width":271.4759999999997,"hasEOL":true},{"str":"norskspråklige.","transform":[12,0,0,12,222.72,499.68],"width":73.55999999999997,"hasEOL":false},{"str":"For disse emnene vil undervisning og","transform":[12,0,0,12,299.28,499.68],"width":180.48000000000002,"hasEOL":true},{"str":"eksamensoppgaver være på norsk. Pensumlitteratur er ofte likevel på","transform":[12,0,0,12,222.71999999999997,485.88],"width":330.76799999999946,"hasEOL":true},{"str":"engelsk. For å gi et studietilbud i informatikk til internasjonale","transform":[12,0,0,12,222.71999999999997,472.08],"width":303.5279999999997,"hasEOL":true},{