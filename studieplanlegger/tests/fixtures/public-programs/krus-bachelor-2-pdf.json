:[9,0,0,9,391.27,348.41]},{"str":"KRUS1200","transform":[9,0,0,9,472.78,400.13]},{"str":"Kriminalitet og straff","transform":[9,0,0,9,455.74,389.81]},{"str":"(10 stp)","transform":[9,0,0,9,480.34,379.49]},{"str":"HØGSKOLEKANDIDAT I STRAFFEGJENNOMFØRING","transform":[12,0,0,12,70.824,304.01]},{"str":"De fire første semestrene i studiet er organisert som et heltidsstudium over to år og gir breddekompetanse i","transform":[9,0,0,9,70.824,286.85]},{"str":"straffegjennomføring. Studiet fører fram til graden høgskolekandidat i straffegjennomføring og er en","transform":[9,0,0,9,70.824,274.97]},{"str":"lønnet","transform":[9,0,0,9,468.7,274.97]},{"str":"grunnutdanning som kvalifiserer for arbeid som fengselsbetjent i kriminalomsorgen.","transform":[9,0,0,9,70.824,262.94]},{"str":"Studiet legger til rette for god læringsprogresjon for studentene.","transform":[9,0,0,9,70.824,241.1]},{"str":"2","transform":[6,0,0,6,323.59,244.1]},{"str":"Det gjelder både for tilegnelse av teoretisk","transform":[9,0,0,9,329.47,241.1]},{"str":"kunnskap, praktiske ferdigheter og utvikling av identitet som fengselsbetjent. I alle fire semestrene legges det vekt","transform":[9,0,0,9,70.824,229.22]},{"str":"på kobling mellom praksisbasert og forskningsbasert kunnskap.","transform":[9,0,0,9,70.824,217.22]},{"str":"Første semester gjennomføres ved høgskolen. I dette semesteret blir studentene introdusert for","transform":[9,0,0,9,70.824,195.5]},{"str":"kriminalomsorgen og fengselsbetjentyrket, og tilegner seg grunnleggende kunnskaper og ferdigheter for å arbeide","transform":[9,0,0,9,70.824,183.5]},{"str":"som fengselsbetjent. Første semester skal forberede studentene for videre studier i opplæringsenhetene. De skal","transform":[9,0,0,9,70.824,171.62]},{"str":"etablere gode studievaner, evne å samarbeide om studieoppgaver, beherske gjeldende læringsplattform, få","transform":[9,0,0,9,70.824,159.74]},{"str":"innføring i vitenskapelig tenkning og akademisk skriving.","transform":[9,0,0,9,70.824,147.74]},{"str":"I andre og tredje semester organiseres studiene som praksisstudier i en opplæringsenhet. Disse semestrene er","transform":[9,0,0,9,70.824,125.9]},{"str":"dels veiledet praksis og dels ordinære studier som organiseres av KRUS i samarbeid med enheten. Dedikerte","transform":[9,0,0,9,70.824,114.02]},{"str":"2","transform":[5.04,0,0,5.04,70.824,83.52]},{"str":"Studentene i høgskolekandidatstudiet benevnes formelt som aspiranter, jf. Forskrift om aspiranter i kriminalomsorgen. I dette","transform":[7.56,0,0,7.56,75.744,81]},{"str":"dokumentet benevnes alle som studenter for å sikre en helhetlig beskrivelse av studiet.","transform":[7.56,0,0,7.56,70.824,72.36]}]},{"page":6,"items":[{"str":"Studiet består av tre obligatoriske fellesemner, KRUS3000 Kriminalomsorgen som virksomhet (15 stp.),","transform":[9,0,0,9,70.824,476.47]}]}]
