{
  "name": "studieplanlegger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 80 --strictPort",
    "dev:legacy": "vite --host localhost --port 5173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:release": "vitest run tests/unit/hosted-import.test.js tests/unit/storage.test.js tests/unit/ajour-compatibility.test.js tests/unit/theme-init.test.js tests/unit/fhs-programs.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node tests/run-built-e2e.mjs",
    "test:e2e:deployment": "node scripts/deployment-smoke.mjs",
    "test:e2e:remote": "playwright test --config tests/playwright.remote.config.js --project remote-core --project remote-visual --project remote-failures",
    "test:e2e:remote:live": "playwright test --config tests/playwright.remote.config.js --project remote-live",
    "test:e2e:remote:trial": "playwright test --config tests/playwright.remote.config.js --project remote-trial",
    "test:e2e:remote:trial:live": "playwright test --config tests/playwright.remote.config.js --project remote-trial-live",
    "test:e2e:remote:persistence": "playwright test --config tests/playwright.remote.config.js --project remote-persistence",
    "test:e2e:database": "node tests/run-database-e2e.mjs",
    "test:e2e:docker": "playwright test --config=playwright.docker.config.js",
    "verify:teaching": "node scripts/verify-teaching.mjs",
    "verify:teaching:live": "node scripts/verify-teaching.mjs --live",
    "build": "vite build",
    "build:release": "npm run test:release && npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node server/app.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.2.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cheerio": "^1.2.0",
    "ical.js": "^2.2.1",
    "mammoth": "1.12.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.2.108"
  }
}
